# DeepSeek 大模型配置（复制为 .env 并填入你的 API Key 保存即可，无需重启服务）
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# 运行失败告警（可选）：配置后失败会 POST 到该 Webhook，不配则只打服务端日志
ALERT_WEBHOOK_URL=

# L3 内网视觉 Agent（可选；不配则跳过 L3 兜底）
# 也可用 data/visual-agent.json 配置（无需重启）：{"url":"http://127.0.0.1:3020","timeoutMs":15000,"minConfidence":0.6,"maxCallsPerRun":3}
VISUAL_AGENT_URL=
VISUAL_AGENT_TIMEOUT_MS=15000
VISUAL_AGENT_MIN_CONFIDENCE=0.6
VISUAL_AGENT_MAX_CALLS_PER_RUN=3
